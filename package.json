{
  "name": "aseprite-asset-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "description": "Token-efficient TypeScript MCP asset factory for Aseprite, pixel art, animation, and Godot exports.",
  "scripts": {
    "mcp": "tsx src/interfaces/mcp-server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:ts",
    "test:ts": "tsx --test \"tests-ts/**/*.test.ts\"",
    "asset:character": "tsx scripts/character-workflow.ts",
    "asset:scene": "tsx scripts/scene-workflow.ts",
    "asset:paint": "tsx scripts/paint-godot-assets.ts",
    "asset:creatures": "tsx scripts/paint-creature-assets.ts",
    "asset:battle-impact": "tsx scripts/paint-battle-impact.ts",
    "asset:steam-pack": "tsx scripts/paint-steam-visual-pack.ts",
    "asset:deck-portraits": "tsx scripts/paint-creature-deck-portraits.ts",
    "asset:npc-expressions": "tsx scripts/paint-npc-expressions.ts",
    "asset:healing-fx": "tsx scripts/paint-healing-spark.ts",
    "asset:odiseum-style": "tsx scripts/boost-odiseum-style.ts",
    "asset:odiseum-world": "tsx scripts/paint-odiseum-world.ts",
    "asset:library": "tsx scripts/paint-reusable-asset-library.ts",
    "asset:library:catalog": "tsx scripts/generate-asset-library.ts",
    "asset:library:catalog:force": "tsx scripts/generate-asset-library.ts --force",
    "asset:reference-fauna": "tsx scripts/generate-reference-fauna-assets.ts",
    "asset:premium-dragon": "tsx scripts/generate-premium-dragon-asset.ts",
    "asset:cozy-nature": "tsx scripts/paint-cozy-nature-assets.ts",
    "showcase": "tsx scripts/generate-showcase.ts",
    "showcase:effects": "tsx scripts/generate-effects-showcase.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pureimage": "^0.4.20",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
